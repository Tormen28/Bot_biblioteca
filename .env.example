# ==================================
# CONFIGURACIÓN DEL BOT DE TELEGRAM
# ==================================

# Token del Bot (obténlo de @BotFather en Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# IDs de Administradores (obténlo de @userinfobot en Telegram)
# Si hay varios admins, sepáralos por comas: 123456789,987654321
ADMIN_IDS=123456789

# ==================================
# BASE DE DATOS POSTGRESQL (Opcional)
# ==================================
# Si dejas esto vacío, el bot usará SQLite (local, más fácil).
# Solo llena esto si usas Supabase, Neon, Railway, etc.

# Opción 1: URL completa (recomendado para producción)
# POSTGRES_URL=postgresql://usuario:password@host:5432/database

# Ejemplos de servicios en la nube:
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# Neon: postgresql://usuario:password@ep-xxx.us-east-1.aws.neon.tech/neondb
# Railway: postgresql://postgres:password@containers-us-west-1.railway.app:1234/railway

# Opción 2: Componentes individuales (para desarrollo local)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=biblio_bot
# DB_USER=postgres
# DB_PASSWORD=tu_password_aqui