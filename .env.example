# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Database Configuration
# Option 1: Full connection URL (recommended for production)
POSTGRES_URL=postgresql://username:password@host:port/database

# Option 2: Individual components (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biblio_bot
DB_USER=postgres
DB_PASSWORD=your_password_here

# Alternative: Railway PostgreSQL URL (if using Railway)
# POSTGRES_URL=postgresql://postgres:password@containers-us-west-1.railway.app:1234/railway

# Alternative: Supabase PostgreSQL URL
# POSTGRES_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Production 24/7 - Webhook Configuration
# WEBHOOK_URL=https://your_domain.com/webhook